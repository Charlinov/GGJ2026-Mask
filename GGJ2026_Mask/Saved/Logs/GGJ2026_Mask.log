[2026.01.30-20.37.32:674][375]LogFabLauncher: Debug payload: [{"id":"5af7af37-2c8a-4447-9444-8c9c83cd4872","path":"C:/ProgramData/Epic/EpicGamesLauncher/VaultCache/FabLibrary/Dirt_Farmer_-_Rigged-5af7af37/gltf/converted/dirt_farmer_rigged_gltf_extracted","meshes":[{"file":"C:/ProgramData/Epic/EpicGamesLauncher/VaultCache/FabLibrary/Dirt_Farmer_-_Rigged-5af7af37/gltf/converted/dirt_farmer_rigged_gltf_extracted/scene.gltf","name":"","material_index":0,"lods":[]}],"materials":[],"native_files":[],"additional_textures":[],"metadata":{"launcher":{"version":"0.0.1","listening_port":24563},"fab":{"assetNamespace":"","listing":{"averageRating":5,"createdAt":"","description":"<p>I liked the way this model looked when making him and he made me think of a South American subsistance farmer typicaly seen in movies. He’s a complex model who consists of six seperate parts and a complex rig reflected in the anotations. His teeth and tongue are on the same UV map as his body.</p><p></p><p>NB I had some weight painting to do on his inner mouth and teeth. I’m not really good at weight painting so you might want to check that first. Also, I uploaded him with a control rig complete with widgets, I don’t know if they will be striped out by the Fab software.</p>","isAiForbidden":false,"isAiGenerated":false,"lastUpdatedAt":"2025-02-24T12:44:51.123060Z","listingType":"3d-model","media":"https://media.fab.com/image_previews/gallery_images/7a5131ab-d2bd-4726-a6c5-915727ded385/aaaea9b5-51cb-4d07-bf9c-a804597f1570.jpeg","publishedAt":"2025-01-17T14:46:33.056841Z","reviewCount":1,"thumbnail":"https://media.fab.com/image_previews/gallery_images/3576c283-1633-42e1-863c-263499c8ee3b/cf7fc026-cef2-42b6-82df-ea4463af89bf.jpeg","title":"Dirt Farmer - Rigged","uid":"5af7af37-2c8a-4447-9444-8c9c83cd4872","updatedAt":"","user":{"coverImageUrl":"","profileImageUrl":"","sellerName":"Tony Flanagan","uid":"cb92b907-29e2-49cc-b156-4346d6df9ec4"},"tags":[{"name":"Production","slug":"production","uid":"8ccbb12c